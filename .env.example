# Database (Neon PostgreSQL)
# Get your connection string from: https://neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Cloudinary Configuration
# Get your credentials from: https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# WhatsApp Configuration
# Format: Country code + phone number (no spaces, no + sign)
# Example: For India +91 98765 43210, use: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# Email Configuration (Resend)
# Get your API key from: https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100 emails/day
RESEND_API_KEY="re_123456789"
# Email sender - Must be verified in Resend dashboard
# Format: "Name <email@yourdomain.com>"
EMAIL_FROM="Sudhakant Sarees <orders@sudhakant-sarees.com>"

# OTP Verification Configuration
# Set to "false" to skip OTP verification in development/testing
# Set to "true" to enable real OTP verification in production
OTP_ENABLED="true"

# 2Factor SMS Configuration (for Phone OTP)
# Get your API key from: https://2factor.in/panel/dashboard
# Free tier: 10 SMS per day
# Paid: ~₹0.15-0.20 per SMS
TWOFACTOR_API_KEY="your-2factor-api-key"

# OTP Delivery Method
# "SMS" - Send OTP via text message (default)
# "CALL" - Send OTP via voice call
OTP_DELIVERY_METHOD="SMS"
