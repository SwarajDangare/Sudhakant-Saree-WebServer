# Database (Neon PostgreSQL)
# Get your connection string from: https://neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Cloudinary Configuration
# Get your credentials from: https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# WhatsApp Configuration
# Format: Country code + phone number (no spaces, no + sign)
# Example: For India +91 98765 43210, use: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# Email Configuration (Resend)
# Get your API key from: https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100 emails/day
RESEND_API_KEY="re_123456789"
# Email sender - Must be verified in Resend dashboard
# Format: "Name <email@yourdomain.com>"
EMAIL_FROM="Sudhakant Sarees <orders@sudhakant-sarees.com>"

# OTP Testing Configuration
# Set to "false" to disable OTP verification (for testing only!)
# When disabled, any OTP matching TEST_OTP will be accepted
OTP_VERIFICATION_ENABLED="true"
# Test OTP to use when OTP_VERIFICATION_ENABLED is false
# Default: "123456"
TEST_OTP="123456"
